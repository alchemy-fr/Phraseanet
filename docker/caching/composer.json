{
  "name": "phraseanet/phraseanet",
  "description": "Phraseanet",
  "license": "GPL-3.0",
  "config": {
    "bin-dir": "bin/",
    "allow-plugins": {
      "cweagans/composer-patches": true
    },
    "platform": {
      "php": "8.5.0"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*"
    },
    {
      "type": "package",
      "package": {
        "name": "exiftool/exiftool",
        "version": "11",
        "source": {
          "url": "https://github.com/exiftool/exiftool.git",
          "type": "git",
          "reference": "11.84"
        }
      }
    },
    {
      "type": "git",
      "url": "https://github.com/alchemy-fr/embed-bundle.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-intl": "*",
    "ext-zmq": "*",
    "alchemy/embed-bundle": "^2.0.16",
    "alchemy/geonames-api-consumer": "^5.0",
    "alchemy/mediavorus": "^5.0",
    "alchemy/oauth2php": "^2.0",
    "alchemy/phlickr": "0.2.9",
    "alchemy/phpexiftool": "^4.2",
    "alchemy/queue-bundle": "^5.0",
    "alchemy/silex": "^3.0",
    "alchemy/symfony-cors": "^5.0",
    "alchemy/task-manager": "^6.0",
    "alchemy/worker-bundle": "^5.0",
    "alchemy/zippy": "^2.0",
    "beberlei/assert": "^3.3",
    "cocur/slugify": "^4.6",
    "cweagans/composer-patches": "^1.7",
    "czproject/git-php": "^4.6",
    "dailymotion/sdk": "^1.7",
    "data-uri/data-uri": "^1.0",
    "dflydev/doctrine-orm-service-provider": "^2.0.1",
    "doctrine/annotations": "^2.0",
    "doctrine/cache": "^1.13",
    "doctrine/dbal": "^3.10",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^2.20",
    "elasticsearch/elasticsearch": "^2.5",
    "exiftool/exiftool": "^11",
    "firebase/php-jwt": "^7.2",
    "gedmo/doctrine-extensions": "^3.22",
    "goodby/csv": "^1.3",
    "google/recaptcha": "^1.3",
    "guzzlehttp/guzzle": "^7.9",
    "hoa/compiler": "^3.17",
    "igorw/get-in": "^1.0",
    "imagine/imagine": "^1.5",
    "janu-software/facebook-php-sdk": "^0.4",
    "jms/serializer": "^3.32",
    "jms/translation-bundle": "^2.7",
    "justinrainbow/json-schema": "^6.13",
    "league/fractal": "^0.99",
    "media-alchemyst/media-alchemyst": "^5.0",
    "monolog/monolog": "^3.9",
    "mrclay/minify": "^4.0",
    "neutron/temporary-filesystem": "^4.0",
    "openspout/openspout": "^5.12",
    "pagerfanta/pagerfanta": "^4.7",
    "paragonie/random-lib": "^2.0.3",
    "php-amqplib/php-amqplib": "^3.7",
    "php-ffmpeg/php-ffmpeg": "^1.4",
    "php-mp4box/php-mp4box": "^5.0",
    "php-unoconv/php-unoconv": "^5.0",
    "php-xpdf/php-xpdf": "^5.0",
    "phpoffice/phpspreadsheet": "^5.10",
    "pimple/pimple": "^3.6",
    "pusher/pusher-php-server": "^7.3",
    "ramsey/uuid": "^4.7",
    "sorien/silex-pimple-dumper": "^2.0",
    "swiftmailer/swiftmailer": "^6.3",
    "symfony/browser-kit": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/doctrine-bridge": "^7.4",
    "symfony/dom-crawler": "^7.4",
    "symfony/error-handler": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/filesystem": "^7.4",
    "symfony/finder": "^7.4",
    "symfony/form": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/intl": "^7.4",
    "symfony/mime": "^7.4",
    "symfony/options-resolver": "^7.4",
    "symfony/password-hasher": "^7.4",
    "symfony/process": "^7.4",
    "symfony/property-access": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/stopwatch": "^7.4",
    "symfony/translation": "^7.4",
    "symfony/twig-bridge": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/yaml": "^7.4",
    "tecnickcom/tcpdf": "^6.11",
    "themattharris/tmhoauth": "^0.8.4",
    "twig/twig": "^3.21",
    "vierbergenlars/php-semver": "^3.0.4",
    "willdurand/negotiation": "^3.1",
    "zend/gdata": "~1.12.1"
  },
  "require-dev": {
    "mikey179/vfsstream": "^1.6.12",
    "phpunit/phpunit": "^11.5",
    "phpspec/prophecy-phpunit": "^2.3"
  },
  "autoload": {
    "psr-0": {
      "Alchemy\\": "lib",
      "": "lib/classes"
    }
  },
  "include-path": [
    "vendor/zend/gdata/library"
  ],
  "extra": {
    "branch-alias": {
      "dev-master": "4.1.x-dev"
    },
    "patches": {
      "alchemy/embed-bundle": {
        "PHP 8.5 and Silex 2 compatibility": "patches/alchemy-embed-bundle.patch"
      },
      "dflydev/doctrine-orm-service-provider": {
        "Doctrine Persistence 2+ namespaces and attribute mapping driver": "patches/dflydev-doctrine-orm-service-provider.patch"
      },
      "hoa/compiler": {
        "PHP 8.5 deprecations": "patches/hoa-compiler.patch"
      },
      "hoa/file": {
        "PHP 8.5 deprecations": "patches/hoa-file.patch"
      },
      "hoa/iterator": {
        "PHP 8.5 deprecations": "patches/hoa-iterator.patch"
      },
      "hoa/protocol": {
        "PHP 8.5 deprecations": "patches/hoa-protocol.patch"
      },
      "hoa/stream": {
        "PHP 8.5 deprecations": "patches/hoa-stream.patch"
      },
      "react/promise": {
        "PHP 8.5 deprecations": "patches/react-promise.patch"
      }
    }
  }
}
