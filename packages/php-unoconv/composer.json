{
    "name": "php-unoconv/php-unoconv",
    "version": "5.0.0",
    "type": "library",
    "description": "Unoconv PHP, an Object Oriented library for easy file conversion with LibreOffice's unoconv",
    "keywords": [
        "unoconv"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Neutron",
            "email": "imprec@gmail.com",
            "homepage": "http://www.lickmychip.com/"
        },
        {
            "name": "Phraseanet Team",
            "email": "info@alchemy.fr",
            "homepage": "http://www.phraseanet.com/"
        }
    ],
    "require": {
        "php": "^8.2",
        "alchemy/binary-driver": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "pimple/pimple": "^3.6"
    },
    "autoload": {
        "psr-0": {
            "Unoconv": "src"
        }
    },
    "suggest": {
        "pimple/pimple": "To use the UnoconvServiceProvider"
    },
    "autoload-dev": {
        "psr-0": {
            "Unoconv\\Tests": "tests"
        }
    }
}
