  "version": "5.0.0",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.2",
    "ramsey/uuid": "^4.7",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpspec/prophecy-phpunit": "^2.3",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "ext-amqp": "To use the AMQP extension adapters"
  },
  "autoload": {
    "psr-4": {
      "Alchemy\\Queue\\": "src/"
    }
