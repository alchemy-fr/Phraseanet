{
    "name": "media-alchemyst/media-alchemyst",
    "version": "5.0.0",
    "type": "library",
    "description": "An Object Oriented wrapper for easy multimedia conversion, based on Imagine, FFMpeg, Unoconv and other libs",
    "keywords": [
        "video processing",
        "video",
        "audio processing",
        "audio",
        "image",
        "image processing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Neutron",
            "email": "imprec@gmail.com",
            "homepage": "http://www.lickmychip.com/"
        },
        {
            "name": "Phraseanet Team",
            "email": "info@alchemy.fr",
            "homepage": "http://www.phraseanet.com/"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "exiftool/exiftool",
                "version": "12.42",
                "source": {
                    "url": "https://github.com/exiftool/exiftool",
                    "type": "git",
                    "reference": "12.42"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "alchemy/binary-driver": "^6.0",
        "alchemy/ghostscript": "^5.0",
        "alchemy/mediavorus": "^5.0",
        "alchemy/phpexiftool": "^4.2",
        "imagine/imagine": "^1.5",
        "neutron/temporary-filesystem": "^4.0",
        "php-ffmpeg/php-ffmpeg": "^1.4",
        "php-mp4box/php-mp4box": "^5.0",
        "php-unoconv/php-unoconv": "^5.0",
        "pimple/pimple": "^3.6",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-0": {
            "MediaAlchemyst": "src"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "MediaAlchemyst\\Tests": "tests"
        }
    }
}
