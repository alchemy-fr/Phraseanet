{
  "name": "alchemy/queue-bundle",
  "description": "Symfony bundle for alchemy/queue-component",
  "version": "5.0.0",
  "authors": [
    {
      "name": "Thibaud Fabre",
      "email": "thibaud@aztech.io"
    }
  ],
  "autoload": {
    "psr-4": {
      "Alchemy\\QueueBundle\\": "src/QueueBundle",
      "Alchemy\\QueueProvider\\": "src/QueueProvider"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alchemy\\QueueBundle\\Tests\\": "tests/unit/QueueBundle",
      "Alchemy\\QueueProvider\\Tests\\": "tests/unit/QueueProvider"
    }
  },
  "license": "MIT",
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/http-kernel": "^7.4"
  },
  "require": {
    "php": "^8.2",
    "alchemy/queue-component": "^5.0",
    "pimple/pimple": "^3.6",
    "silex/silex": "^2.3"
  },
  "suggest": {
    "symfony/config": "To use the Symfony bundle (^7.4)",
    "symfony/dependency-injection": "To use the Symfony bundle (^7.4)",
    "symfony/http-kernel": "To use the Symfony bundle (^7.4)"
  }
}
