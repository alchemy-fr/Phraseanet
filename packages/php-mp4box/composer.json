{
    "name": "php-mp4box/php-mp4box",
    "version": "5.0.0",
    "type": "library",
    "description": "PHP MP4Box, an Object Oriented library for easy file conversion with MP4 Box",
    "keywords": [
        "mp4box",
        "gpac"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Neutron",
            "email": "imprec@gmail.com",
            "homepage": "http://www.lickmychip.com/"
        },
        {
            "name": "Phraseanet Team",
            "email": "info@alchemy.fr",
            "homepage": "http://www.phraseanet.com/"
        }
    ],
    "require": {
        "php": "^8.2",
        "alchemy/binary-driver": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "pimple/pimple": "^3.6"
    },
    "autoload": {
        "psr-0": {
            "MP4Box": "src"
        }
    },
    "suggest": {
        "pimple/pimple": "To use the MP4BoxServiceProvider"
    },
    "autoload-dev": {
        "psr-0": {
            "MP4Box\\Tests": "tests",
            "MP4Box\\Functional": "tests"
        }
    }
}
